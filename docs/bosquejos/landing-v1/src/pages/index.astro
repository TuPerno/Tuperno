---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ProductCarousel from '../components/ProductCarousel.astro';
import Features from '../components/Features.astro';
import ContactForm from '../components/ContactForm.astro';
import Testimonials from '../components/Testimonials.astro';
import CTAFooter from '../components/CTAFooter.astro';
---

<Layout>
	<main class="min-h-screen bg-white">
		<Hero>
			<ProductCarousel />
		</Hero>

		<Features />

		<!-- Marcas Comercializadas -->
		<section class="bg-white py-16">
			<div class="container mx-auto px-6 max-w-6xl">
				<h3 class="text-2xl font-bold text-center text-[#1E3A8A] mb-4">
					Marcas de Confianza
				</h3>
				<p class="text-center text-slate-700 mb-10">
					Trabajamos con las mejores marcas de herramientas y fijaciones
				</p>
				<div class="flex flex-wrap justify-center items-center gap-12">
					<div class="bg-slate-50 rounded-2xl px-8 py-6 shadow-md hover:shadow-lg transition-shadow">
						<div class="text-4xl font-black text-yellow-500" style="font-family: Arial, sans-serif;">
							STANLEY
						</div>
					</div>
					
					<div class="bg-slate-50 rounded-2xl px-8 py-6 shadow-md hover:shadow-lg transition-shadow">
						<div class="text-4xl font-black text-red-600" style="font-family: Arial, sans-serif;">
							W-MAX
						</div>
					</div>
					
					<div class="bg-slate-50 rounded-2xl px-8 py-6 shadow-md hover:shadow-lg transition-shadow">
						<div class="text-3xl font-bold text-slate-700 flex items-center gap-2">
							<span class="text-4xl">🔧</span>
							<span>Herramientas de Calidad</span>
						</div>
					</div>
					
					<div class="bg-slate-50 rounded-2xl px-8 py-6 shadow-md hover:shadow-lg transition-shadow">
						<div class="text-3xl font-bold text-[#1E3A8A] flex items-center gap-2">
							<span class="text-4xl">🔩</span>
							<span>Fijaciones Profesionales</span>
						</div>
					</div>
				</div>
			</div>
		</section>

		<ContactForm />
		
		<Testimonials />
		
		<CTAFooter />
