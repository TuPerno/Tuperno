---
import { CONTACT_INFO } from '../config/constants';

const whatsappFormUrl = `${CONTACT_INFO.whatsappUrl}?text=Hola,%20necesito%20información%20sobre%20productos`;
---

<section class="bg-white py-20">
	<div class="container mx-auto px-6 max-w-5xl">
		<div class="bg-gradient-to-br from-blue-50 to-slate-50 rounded-3xl shadow-2xl overflow-hidden border-2 border-slate-200">
			<div class="p-12">
				<div class="text-center mb-12">
					<h2 class="text-4xl font-black text-primary mb-4">
						¿Necesitas pernos o fijaciones especiales?
					</h2>
					<p class="text-xl text-slate-600 max-w-2xl mx-auto">
						Contáctanos ahora y recibe asesoría personalizada. Stock completo y entrega rápida.
					</p>
				</div>

				<div class="grid lg:grid-cols-2 gap-10">
					<!-- Lado izquierdo: Imagen y beneficios -->
					<div class="space-y-8">
						<div class="bg-white rounded-2xl shadow-lg overflow-hidden">
							<img src="/images/TuPernoLocal.png" alt="Local TuPerno - Ferretería en San Pedro de la Paz" class="w-full h-64 object-cover" />
						</div>

						<div class="space-y-4">
							<div class="flex items-start gap-3">
								<span class="text-green-500 text-2xl flex-shrink-0">✓</span>
								<p class="text-slate-700"><strong>Todas las medidas disponibles</strong> - Stock completo</p>
							</div>
							<div class="flex items-start gap-3">
								<span class="text-green-500 text-2xl flex-shrink-0">✓</span>
								<p class="text-slate-700"><strong>Entrega rápida</strong> - Asesoría personalizada</p>
							</div>
							<div class="flex items-start gap-3">
								<span class="text-green-500 text-2xl flex-shrink-0">✓</span>
								<p class="text-slate-700"><strong>Descuentos por volumen</strong> - Precios competitivos</p>
							</div>
						</div>

						<div class="grid grid-cols-3 gap-4 pt-4">
							<div class="text-center">
								<div class="w-16 h-16 bg-primary rounded-full flex items-center justify-center mx-auto mb-2">
									<span class="text-2xl">🔩</span>
								</div>
								<p class="text-sm font-semibold text-slate-700">+1000 productos</p>
							</div>
							<div class="text-center">
								<div class="w-16 h-16 bg-secondary rounded-full flex items-center justify-center mx-auto mb-2">
									<span class="text-2xl">⚡</span>
								</div>
								<p class="text-sm font-semibold text-slate-700">Respuesta inmediata</p>
							</div>
							<div class="text-center">
								<div class="w-16 h-16 bg-green-600 rounded-full flex items-center justify-center mx-auto mb-2">
									<span class="text-2xl">✓</span>
								</div>
								<p class="text-sm font-semibold text-slate-700">Garantía total</p>
							</div>
						</div>
					</div>

					<!-- Lado derecho: Formulario -->
					<div class="bg-white rounded-2xl shadow-xl p-8">
						<h3 class="text-2xl font-bold text-primary mb-6 text-center">
							Recibe nuestro catálogo
						</h3>
						<form class="space-y-5" id="catalogForm">
							<div>
								<input 
									type="text" 
									id="form-nombre"
									required
									class="form-input"
									placeholder="Nombre completo"
								/>
							</div>
							<div>
								<input 
									type="email"
									required
									class="form-input"
									placeholder="Correo electrónico"
								/>
							</div>
							<div>
								<input 
									type="tel"
									class="form-input"
									placeholder="Teléfono (opcional)"
								/>
							</div>
							<button 
								type="submit"
								class="btn-submit">
								QUIERO EL CATÁLOGO
							</button>
						</form>

						<!-- Botón WhatsApp directo -->
						<div class="mt-6 pt-6 border-t-2 border-slate-200">
							<a href={whatsappFormUrl}
							   target="_blank"
							   rel="noopener noreferrer"
							   class="btn-whatsapp">
								<span class="inline-flex items-center justify-center gap-3">
									<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
									ESCRÍBENOS POR WHATSAPP
								</span>
							</a>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>

<style>
	.text-primary {
		color: #B71C1C;
	}

	.bg-primary {
		background: #B71C1C;
	}

	.bg-secondary {
		background: #FBC02D;
	}

	.form-input {
		width: 100%;
		padding: 1rem;
		border-radius: 0.75rem;
		border: 2px solid #cbd5e1;
		transition: all 0.3s ease;
	}

	.form-input:focus {
		outline: none;
		border-color: #B71C1C;
	}

	.btn-submit {
		width: 100%;
		background: #FBC02D;
		color: #121212;
		padding: 1.25rem 2rem;
		border-radius: 0.75rem;
		font-weight: bold;
		font-size: 1.25rem;
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
		transition: all 0.3s ease;
		border: none;
		cursor: pointer;
	}

	.btn-submit:hover {
		background: #F9A825;
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
		transform: scale(1.05);
	}

	.btn-whatsapp {
		display: block;
		width: 100%;
		background: #10b981;
		color: white;
		padding: 1rem 2rem;
		border-radius: 0.75rem;
		font-weight: bold;
		font-size: 1.125rem;
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1);
		transition: all 0.3s ease;
		text-align: center;
	}

	.btn-whatsapp:hover {
		background: #059669;
		box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.2);
		transform: scale(1.05);
	}
</style>

<script>
	const form = document.getElementById('catalogForm');
	const nombre = document.getElementById('form-nombre') as HTMLInputElement;

	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		const whatsappUrl = `https://wa.me/56951997763?text=Hola, soy ${encodeURIComponent(nombre.value)}. Necesito información sobre pernos y fijaciones`;
		window.open(whatsappUrl, '_blank');
	});
</script>
