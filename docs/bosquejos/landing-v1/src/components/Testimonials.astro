---
import { TESTIMONIALS } from '../config/testimonials';

const featuredTestimonial = TESTIMONIALS.find(t => t.featured);
const regularTestimonials = TESTIMONIALS.filter(t => !t.featured);

const colorClasses: Record<string, string> = {
	orange: 'bg-orange-500',
	blue: 'bg-blue-500',
	green: 'bg-green-500',
	purple: 'bg-purple-500',
	pink: 'bg-pink-500'
};
---

<section class="bg-gray-50 py-20">
	<div class="container mx-auto px-6 max-w-4xl">
		<h2 class="text-3xl lg:text-4xl font-bold text-center text-gray-900 mb-4">
			Lo que dicen nuestros clientes
		</h2>
		<p class="text-center text-gray-600 mb-16 text-lg">
			Testimonios reales de personas que confían en nosotros
		</p>

		<!-- Testimonio destacado -->
		{featuredTestimonial && (
			<div class="bg-white rounded-3xl p-12 shadow-xl max-w-3xl mx-auto">
				<div class="text-center space-y-6">
					<div class="flex gap-1 justify-center mb-4">
						{[...Array(featuredTestimonial.rating)].map(() => (
							<span class="text-yellow-400 text-2xl">⭐</span>
						))}
					</div>
					<p class="text-2xl text-gray-700 leading-relaxed italic">
						"{featuredTestimonial.comment}"
					</p>
					<div class="flex items-center gap-3 justify-center">
						<div class={`w-12 h-12 ${colorClasses[featuredTestimonial.color]} rounded-full flex items-center justify-center text-white font-bold`}>
							{featuredTestimonial.initials}
						</div>
						<div>
							<p class="font-bold text-gray-900 text-xl">{featuredTestimonial.name}</p>
							<p class="text-gray-600">Cliente satisfecho</p>
						</div>
					</div>
				</div>
			</div>
		)}

		<!-- Grid de testimonios adicionales -->
		<div class="grid md:grid-cols-2 gap-8 mt-12 max-w-5xl mx-auto">
			{regularTestimonials.map(testimonial => (
				<div class="bg-white rounded-2xl p-8 shadow-lg">
					<div class="flex gap-1 mb-4">
						<span class="text-yellow-400 text-xl">⭐⭐⭐⭐⭐</span>
					</div>
					<p class="text-gray-700 italic mb-6">
						"{testimonial.comment}"
					</p>
					<div class="flex items-center gap-3">
						<div class={`w-12 h-12 ${colorClasses[testimonial.color]} rounded-full flex items-center justify-center text-white font-bold`}>
							{testimonial.initials}
						</div>
						<div>
							<p class="font-bold text-gray-900">{testimonial.name}</p>
							<p class="text-sm text-gray-600">Cliente</p>
						</div>
					</div>
				</div>
			))}
		</div>
	</div>
</section>
